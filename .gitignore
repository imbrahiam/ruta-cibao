# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: only the example is tracked
!.env.example

# agent working files (kept local, never committed)
AGENTS.md
CLAUDE.md
.mcp.json
.agent-work/

# local infra state
/minio-data/
/postgres-data/

# playwright
/test-results/
/playwright-report/

# vendored agent skills (npx skills add)
/.agents/
/.claude/
skills-lock.json

# service worker build output
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# extracted basemap (built with `bun run basemap`, not committed)
/public/basemap/

# locally downloaded dev binaries, not committed
/.tooling/

# glyph packs fetched by `bun run basemap:fonts`
/public/fonts/
/public/sprites/

# Local release snapshots
/backups/
/storage-data/

# MapLibre worker, copied from node_modules by scripts/vendor-maplibre.ts
/public/vendor/
