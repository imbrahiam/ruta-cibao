# Copy to .env and fill in. Never commit .env — this file is the only tracked one.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Public origin of the app. Used for auth callbacks, emails and absolute URLs.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Postgres 16 with the postgis and vector extensions enabled.
DATABASE_URL=postgresql://ruta:ruta@localhost:5432/ruta_cibao

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# --- JCE cedula lookup --------------------------------------------------
# Dominican civil registry lookup: cedula -> registered full name.
# Server-side only: the upstream restricts CORS and the key must never reach the browser.
JCE_API_URL=https://jce.genlabs.us
JCE_API_KEY=replace-me
# Set to 1 to bypass the network and use the local fixture client (CI, offline demo).
JCE_USE_MOCK=0

# --- Encryption ---------------------------------------------------------
# 32 bytes as hex. Generate with: openssl rand -hex 32
# Encrypts cedulas and other personal data at rest. Rotating it makes existing
# ciphertext unreadable — read OPERATIONS.md before you do.
APP_ENCRYPTION_KEY=replace-me-with-64-hex-characters

# --- Assistant ----------------------------------------------------------
# Semantic search runs locally: Transformers.js embeddings into pgvector, no
# key and no bill. Backfill the vectors with:
#   bun run db:embed
# This key only buys the sentence wrapped around the results. Without it the
# assistant answers from a deterministic Spanish template and still works.
ANTHROPIC_API_KEY=

# --- Google sign-in -----------------------------------------------------
# Optional. Create an OAuth client at console.cloud.google.com and add
# <APP_URL>/api/auth/callback/google as an authorised redirect URI.
# Leave unset to hide the button; phone and email sign-in are unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS ----------------------------------------------------------------
# A phone number is the default way into the app, so the sign-in code arrives
# by text. Leave these unset in development: the code is written to the server
# log instead of being sent, and sign-in still works end to end.
# Twilio and not Firebase because FCM delivers push to an app that is already
# installed, which cannot be how somebody signs in for the first time.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sending number, in E.164.
TWILIO_FROM=

# --- Email --------------------------------------------------------------
# Leave RESEND_API_KEY unset in development: magic links are logged instead.
RESEND_API_KEY=
EMAIL_FROM=Ruta Cibao <onboarding@resend.dev>

# --- Web Push -----------------------------------------------------------
# Generate with: bunx web-push generate-vapid-keys
# Leave unset to disable push; the in-app notification centre still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:soporte@rutacibao.do

# --- Testing on a phone -------------------------------------------------
# `next dev` blocks cross-origin requests to its own assets, so opening the app
# from a phone on the same Wi-Fi needs the host allowlisted. The private LAN
# ranges and `*.local` are allowed already; add anything else here, comma
# separated (a tunnel host, a machine name).
DEV_ORIGINS=

# --- Street geometry -----------------------------------------------------
# Lets a traffic report cover the street the crosshair is on rather than a dot
# on it: the map shades the road and the report carries its shape. Comes from
# OpenStreetMap through Overpass — same project as the geocoder above, free and
# no key needed.
#
# Leave it empty to turn the feature off; reports then fall back to a point.
# Point it at your own instance if you would rather not lean on the public one.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Background jobs -----------------------------------------------------
# pg-boss keeps its queues in the database above, in its own schema, so there
# is nothing extra to run or back up. The worker container owns that schema and
# runs the cron: weekly reports, traffic expiry, notification fan-out, JCE
# retries and the cleanup sweeps.
#
# Set to 0 and every job runs in-process on the request that caused it instead,
# which is what `bun run dev` and a single-container demo want. Nothing is lost
# either way; the work simply happens sooner and on the wrong thread.
JOBS_ENABLED=1
JOBS_SCHEMA=pgboss

# --- Proxy --------------------------------------------------------------
# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For.
TRUSTED_PROXY=0

# --- Object storage (S3 compatible) -------------------------------------
# MinIO locally; any S3-compatible service works (AWS, Cloudflare R2).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ruta-cibao
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; AWS and R2 do not.
S3_FORCE_PATH_STYLE=1

# --- imgproxy -----------------------------------------------------------
# Signed, on-the-fly resizing so no thumbnails are ever stored.
# Leave unset to serve originals straight from storage.
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Basemap ------------------------------------------------------------
# Preferred: a self-hosted PMTiles file. No key, no bill, no third party, and it
# works offline. `bun run basemap` cuts two of them at street level:
#   /basemap/santiago-rodriguez.pmtiles     the province, ~9 MB
#   /basemap/republica-dominicana.pmtiles   the whole country, ~57 MB
# The country file is the same map ready for other municipalities; the
# province file is the one a phone on a metered plan can save for offline use.
# Whichever is served here is what the "Mapa sin señal" option downloads.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
# Convenient for the demo. Public by design and restricted by domain on
# MapTiler's side. Leave both unset to render the citizen layer on a plain
# ground — a usable map with no keys at all.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Address search -----------------------------------------------------
# `nominatim` uses the public OpenStreetMap geocoder (free, attribution shown,
# results bounded to the province). `none` keeps search working against the
# places the province has put on the map and drops only street addresses.
# Point NOMINATIM_URL at your own instance to remove the external dependency.
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Map renderer -------------------------------------------------------
# google   | familiar and reliable, billed per map load, no offline (its terms
#            forbid caching tiles)
# leaflet  | raster tiles from CARTO, no key and no bill
# maplibre | vector tiles from Postgres over a self-hosted PMTiles basemap:
#            no bill and works offline, the sustainability argument
NEXT_PUBLIC_MAP_RENDERER=google
# Restricted by HTTP referrer on Google's side, like every browser map key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Android app (Google Play) ------------------------------------------
# The Play Store listing is a Trusted Web Activity around this origin, built
# with Bubblewrap (see docs/MOBILE.md). Android verifies the link between the
# app and the site through /.well-known/assetlinks.json, generated from these.
# The fingerprint comes from Play Console → Setup → App signing; add the
# upload key's too, comma-separated, so debug installs verify as well.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
