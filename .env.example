# Copy to .env and fill in. Never commit .env — this file is the only tracked one.

# --- Core ---------------------------------------------------------------
# The Compose stack pins NODE_ENV=production for app, worker and migrate
# whatever this says; this value is for `bun run dev` on a laptop.
NODE_ENV=development
# Public origin of the app. Used for auth callbacks, emails and absolute URLs.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Download links on the public landing (build-time, https only). Leave unset
# until a store listing or test distribution exists: the page then says
# "Próximamente" instead of linking to a page that is not there.
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
# Public MIT repository, linked from the landing and footer.
NEXT_PUBLIC_SOURCE_URL=

# --- Database -----------------------------------------------------------
# Postgres 18 with the postgis and vector extensions enabled.
DATABASE_URL=postgresql://ruta:ruta@localhost:5432/ruta_cibao

# --- Docker Compose ------------------------------------------------------
# Read by infra/docker-compose.yml (pass `--env-file .env`), not by the app.
# Compose builds DATABASE_URL for its containers from these three. Use hex for
# the password (`openssl rand -hex 24`): it goes inside a URL.
POSTGRES_USER=ruta
POSTGRES_PASSWORD=ruta
POSTGRES_DB=ruta_cibao
# The public hostname Caddy requests a certificate for. `localhost` = plain HTTP.
SITE_ADDRESS=localhost
# Self-hosted MinIO only: its public hostname, and the origin allowed to upload.
STORAGE_ADDRESS=storage.localhost
MINIO_CORS_ORIGIN=*
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Native app schemes trusted for sign-in: rutacibao:// and rutacibao-preview://
# always; rutacibao-dev:// and exp:// only outside production. Not configurable.

# --- Encryption ---------------------------------------------------------
# 32 bytes as hex. Generate with: openssl rand -hex 32
# Encrypts personal data at rest. Rotating it makes existing ciphertext
# unreadable — read OPERATIONS.md before you do.
APP_ENCRYPTION_KEY=replace-me-with-64-hex-characters

# --- Phone sign-in (Twilio Verify) ---------------------------------------
# The default way into the app. Twilio Verify generates, sends (Spanish SMS)
# and checks the code. Create a Verify service in the Twilio console, enable
# only the countries you serve, keep its fraud guard on and set spend alerts.
# Leave unset in development: the code is written to the server log instead
# (see AUTH_LOG_DELIVERY). In production, unset means phone sign-in is off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Email --------------------------------------------------------------
# Email sign-in codes (and notifications) go through Resend. Leave unset in
# development: codes are written to the server log instead. In production,
# unset means email sign-in is off. EMAIL_FROM must be on a domain verified in
# Resend (SPF, DKIM, DMARC) or mail lands in spam.
RESEND_API_KEY=
EMAIL_FROM=Ruta Cibao <onboarding@resend.dev>

# Development only. Whether sign-in codes may be written to the server log
# when no SMS or email provider is configured. Defaults to on outside
# production; set 0 to turn it off. Production refuses to boot with 1.
AUTH_LOG_DELIVERY=

# --- Native push --------------------------------------------------------
# Expo enhanced push-security access token. Required in production.
# Unset locally: external delivery is skipped; the in-app inbox still works.
EXPO_PUSH_ACCESS_TOKEN=

# --- Testing on a phone -------------------------------------------------
# `next dev` blocks cross-origin requests to its own assets, so opening the app
# from a phone on the same Wi-Fi needs the host allowlisted. The private LAN
# ranges and `*.local` are allowed already; add anything else here, comma
# separated (a tunnel host, a machine name).
DEV_ORIGINS=

# --- Street geometry -----------------------------------------------------
# Lets a traffic report cover the street the crosshair is on rather than a dot
# on it: the map shades the road and the report carries its shape. Comes from
# OpenStreetMap through Overpass — same project as the geocoder above, free and
# no key needed.
#
# Leave it empty to turn the feature off; reports then fall back to a point.
# Point it at your own instance if you would rather not lean on the public one.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Background jobs -----------------------------------------------------
# pg-boss keeps its queues in the database above, in its own schema, so there
# is nothing extra to run or back up. The worker container owns that schema and
# runs the cron: weekly reports, traffic expiry, notification fan-out and the
# cleanup sweeps.
#
# Set to 0 and every job runs in-process on the request that caused it instead,
# which is what `bun run dev` and a single-container demo want. Nothing is lost
# either way; the work simply happens sooner and on the wrong thread.
JOBS_ENABLED=1
JOBS_SCHEMA=pgboss

# --- Proxy --------------------------------------------------------------
# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For.
TRUSTED_PROXY=0

# --- Hosted demo ----------------------------------------------------------
# 1 only on the contest demonstration (APP_URL on a `demo.` host, e.g.
# https://demo.rutacibao.com). The fictional LOCAL_DEMO_PHONES then sign in
# with LOCAL_DEMO_OTP and seeded demo staff skip TOTP; real numbers still use
# Twilio Verify. Validation refuses it on any other host.
DEMO_DEPLOYMENT=0

# --- Object storage (S3 compatible) -------------------------------------
# MinIO locally; any S3-compatible service works (AWS, Cloudflare R2).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ruta-cibao
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; AWS and R2 do not.
S3_FORCE_PATH_STYLE=1

# --- imgproxy -----------------------------------------------------------
# Signed, on-the-fly resizing so no thumbnails are ever stored.
# Leave unset to serve originals straight from storage.
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Basemap ------------------------------------------------------------
# The display archive has global context through z8 and street-level detail for
# Hispaniola through z15 (~650 MB on the server; PMTiles only transfers visible
# ranges). Build it with `bun run basemap -- mundo`.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=/basemap/mundo-hispaniola.pmtiles
# The phone's explicit "Mapa sin señal" download stays province-only (~9 MB).
# Build it with `bun run basemap -- provincia`.
NEXT_PUBLIC_OFFLINE_BASEMAP_PMTILES_URL=/basemap/santiago-rodriguez.pmtiles
# Convenient for the demo. Public by design and restricted by domain on
# MapTiler's side. Leave both unset to render the citizen layer on a plain
# ground — a usable map with no keys at all.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Address search -----------------------------------------------------
# `nominatim` uses the public OpenStreetMap geocoder (free, attribution shown,
# results bounded to the province). It is only asked when someone submits a
# search, cached, and spaced to one request a second across the whole app, as
# its usage policy requires. `none` keeps search working against the places
# the province has put on the map and drops only street addresses.
# Point NOMINATIM_URL at your own instance to remove the external dependency.
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Map renderer -------------------------------------------------------
# google   | familiar and reliable, billed per map load, no offline (its terms
#            forbid caching tiles)
# leaflet  | online raster tiles; also the automatic fallback without hardware WebGL
# maplibre | vector tiles from Postgres over a self-hosted PMTiles basemap:
#            no bill and works offline, the sustainability argument
NEXT_PUBLIC_MAP_RENDERER=maplibre
# Optional self-hosted raster service for the fallback; use {z}/{x}/{y} placeholders.
# Set the provider's required attribution HTML alongside a custom URL.
# Default OSM tiles are online-only: no bulk download or offline prefetch.
NEXT_PUBLIC_RASTER_TILE_URL=
NEXT_PUBLIC_RASTER_TILE_ATTRIBUTION=
# Restricted by HTTP referrer on Google's side, like every browser map key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Maps SDK key for the native app (iOS + Android). Client-visible by
# design: restrict it to the app bundle ids and the Maps SDKs in Google Cloud.
# The key's project needs billing enabled; without it the SDK draws no tiles.
GOOGLE_MAPS_MOBILE_API_KEY=
# Server-only Google Routes and Places API (New) key; enable both APIs and billing,
# restrict this key to those APIs and the server's outbound IPs. Never use a public key.
# Unset: in-app directions and Google photo fallback are unavailable.
GOOGLE_MAPS_SERVER_API_KEY=
# `apple` draws the iOS basemap with Apple Maps (no key) instead of Google.
EXPO_PUBLIC_MAP_PROVIDER=google

# --- Android app (Google Play) ------------------------------------------
# The Play Store listing is a Trusted Web Activity around this origin, built
# with Bubblewrap (see docs/MOBILE.md). Android verifies the link between the
# app and the site through /.well-known/assetlinks.json, generated from these.
# The fingerprint comes from Play Console → Setup → App signing; add the
# upload key's too, comma-separated, so debug installs verify as well.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# Local development only (APP_URL on localhost): phones listed in
# LOCAL_DEMO_PHONES (E.164, comma separated; `bun run db:seed:demo` prints the
# demo numbers) sign in with the six-digit LOCAL_DEMO_OTP and never reach
# Twilio. Rejected in production.
LOCAL_DEMO_OTP=
LOCAL_DEMO_PHONES=

# Where the worker reaches the web app (compose network address), to refresh
# public caches after a removal. Optional: falls back to APP_URL.
INTERNAL_APP_URL=

# Apple team id for local device builds (`expo run:ios --device`).
APPLE_TEAM_ID=
