# Caddy terminates TLS and proxies to the app container.
# On the VPS, SITE_ADDRESS is the real domain and Caddy provisions a
# certificate automatically. Locally it stays "localhost" and serves plain HTTP.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}

# The self-hosted object store, for deployments that keep photos on this server.
# Phones upload to it directly with presigned URLs, so it needs a public HTTPS
# address of its own; the Host header passes through unchanged, which is what
# keeps those signatures valid. With R2 or S3 this block is never reached.
{$STORAGE_ADDRESS} {
	reverse_proxy storage:9000
}
