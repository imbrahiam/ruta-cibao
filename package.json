{
  "name": "ruta-cibao",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run scripts/vendor-maplibre.ts && next dev",
    "dev:https": "bun run scripts/vendor-maplibre.ts && next dev --experimental-https",
    "build": "bun run scripts/vendor-maplibre.ts && next build",
    "start": "next start",
    "worker": "bun run scripts/worker.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate --config src/lib/auth.config.ts --output src/db/schema/auth.ts -y",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed:demo": "bun run scripts/seed-demo.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "basemap": "bun run scripts/pmtiles-extract.ts",
    "basemap:fonts": "bun run scripts/basemap-fonts.ts",
    "db:boundaries": "bun run scripts/import-boundaries.ts",
    "db:roads": "bun run scripts/import-roads.ts",
    "screenshots": "bun run scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@deck.gl/aggregation-layers": "^9.3.11",
    "@deck.gl/core": "^9.3.11",
    "@deck.gl/layers": "^9.3.11",
    "@deck.gl/mapbox": "^9.3.11",
    "@deck.gl/react": "^9.3.11",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "2.0.0-beta.32",
    "@orpc/json-schema": "2.0.0-beta.32",
    "@orpc/openapi": "2.0.0-beta.32",
    "@orpc/server": "2.0.0-beta.32",
    "@orpc/tanstack-query": "2.0.0-beta.32",
    "@orpc/zod": "2.0.0-beta.32",
    "@react-email/components": "^1.0.12",
    "@scalar/nextjs-api-reference": "0.11.17",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.2",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.40.0",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^6.7.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "pg-boss": "^12.30.0",
    "pmtiles": "^4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "resend": "^6.26.0",
    "serwist": "^9.5.12",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "^0.35.4"
  }
}
