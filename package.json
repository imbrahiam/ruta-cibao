{
  "name": "ruta-cibao",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate --config src/lib/auth.config.ts --output src/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@orpc/client": "2.0.0-beta.32",
    "@orpc/json-schema": "2.0.0-beta.32",
    "@orpc/openapi": "2.0.0-beta.32",
    "@orpc/server": "2.0.0-beta.32",
    "@orpc/tanstack-query": "2.0.0-beta.32",
    "@orpc/zod": "2.0.0-beta.32",
    "@scalar/nextjs-api-reference": "0.11.17",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
