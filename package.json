{
  "name": "ruta-cibao",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun --env-file=../../.env run dev",
    "build": "cd apps/web && bun --env-file=../../.env run build",
    "start": "cd apps/web && bun --env-file=../../.env run start",
    "worker": "bun run scripts/ops/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && cd apps/web && bun run typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test apps/web/tests",
    "test:db": "RUN_DB_TESTS=1 RUN_STORAGE_TESTS=1 bun test apps/web/tests",
    "gen:native": "bun run packages/contracts/scripts/openapi.ts && biome format --write packages/contracts/generated/openapi.json && bun run packages/contracts/scripts/kotlin.ts && bun run packages/shared/scripts/native-strings.ts && bun run packages/shared/scripts/native-tokens.ts",
    "check:docs": "bun run scripts/checks/check-docs.ts",
    "check:quality": "bun run scripts/checks/check-quality.ts",
    "db:generate": "cd apps/web && bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "cd apps/web && bun --env-file=../../.env run src/db/migrate.ts",
    "db:push": "cd apps/web && bun --env-file=../../.env run drizzle-kit push",
    "db:studio": "cd apps/web && bun --env-file=../../.env run drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate --config apps/web/src/lib/auth.config.ts --output apps/web/src/db/schema/auth.ts -y",
    "db:seed": "bun run scripts/db/seed.ts",
    "db:seed:demo": "bun run scripts/db/seed-demo.ts",
    "db:boundaries": "bun run scripts/db/import-boundaries.ts",
    "db:roads": "bun run scripts/db/import-roads.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.3.14",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "^0.35.4"
  }
}
