{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["bun", "geojson"],
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/shared/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules"]
}
